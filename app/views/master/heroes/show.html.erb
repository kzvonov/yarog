<%
  # Now using store accessors directly
  moves = @hero.moves || []
%>

<link rel="stylesheet" href="/ui.css" />

<style>
  .hero-editor-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 15px;
  }

  .hero-back-link {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--accent-blood-light);
    text-decoration: none;
  }

  .hero-back-link:hover {
    text-decoration: underline;
  }

  .hero-save-bar {
    position: sticky;
    top: 0;
    background: var(--bg-card);
    padding: 10px 15px;
    border: 1px solid var(--border-dark);
    margin-bottom: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .hero-meta-info {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .hero-header-title {
    text-align: center;
    margin-bottom: 15px;
  }

  .hero-header-title h1 {
    font-size: 1.8rem;
    margin: 0;
  }

  .hero-header-title .class-name {
    font-size: 0.95rem;
    color: var(--accent-blood-light);
    letter-spacing: 0.3em;
    margin-top: 5px;
    text-transform: uppercase;
  }

  .grid-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .char-count {
    text-align: right;
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .move-item {
    padding: 8px;
    background: var(--input-bg);
    border: 1px solid var(--border-dark);
    border-left: 3px solid var(--accent-blood);
    margin-bottom: 8px;
    cursor: move;
    transition: opacity 0.2s;
  }

  .move-item.dragging {
    opacity: 0.5;
  }

  .move-item.drag-over {
    border-top: 2px solid var(--accent-blood);
  }

  .move-item-header {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-bottom: 6px;
  }

  .move-drag-handle {
    cursor: grab;
    color: var(--text-secondary);
    font-size: 1.2rem;
    user-select: none;
  }

  .move-drag-handle:active {
    cursor: grabbing;
  }

  .move-item input[type="text"] {
    flex: 1;
    padding: 4px 6px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-dark);
    color: var(--text-heading);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .move-item input[type="text"]:focus {
    outline: none;
    border-bottom-color: var(--accent-blood);
  }

  .move-item textarea {
    width: 100%;
    padding: 4px 6px;
    background: transparent;
    border: 1px solid var(--border-dark);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.85rem;
    resize: vertical;
    min-height: 50px;
  }

  .move-item textarea:focus {
    outline: none;
    border-color: var(--accent-blood);
  }

  .move-remove-btn {
    padding: 2px 8px;
    background: var(--bg-dark);
    border: 1px solid var(--border-dark);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 1rem;
  }

  .move-remove-btn:hover {
    background: var(--accent-blood);
    color: var(--text-heading);
  }

  .add-ability-btn {
    width: 100%;
    padding: 8px;
    background: var(--input-bg);
    border: 1px dashed var(--border-dark);
    color: var(--text-secondary);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.9rem;
  }

  .add-ability-btn:hover {
    border-color: var(--accent-blood);
    color: var(--accent-blood-light);
  }

  @media (max-width: 768px) {
    .grid-main {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hero-editor-container">
  <%= link_to "← Back to Heroes", master_heroes_path, class: "hero-back-link" %>

  <div class="hero-save-bar">
    <div class="hero-meta-info">
      Code: <span style="color: var(--accent-gold);"><%= @hero.code %></span>
      <% if @games.any? %>
        • Games: <%= @games.map(&:name).join(", ") %>
      <% end %>
      • Version: <%= @hero.version %>
    </div>
    <div style="display: flex; gap: 8px;">
      <button type="submit" form="hero-form" class="btn">Save</button>
      <%= button_to "Duplicate", duplicate_master_hero_path(@hero), method: :post, class: "btn secondary", data: { turbo_confirm: "Create a copy of this hero?" } %>
      <%= button_to "Delete", master_hero_path(@hero), method: :delete, class: "btn", style: "background: var(--accent-blood);", data: { turbo_confirm: "Are you sure you want to delete '#{@hero.name}'? This action cannot be undone!" } %>
    </div>
  </div>

  <%= form_with model: @hero, url: master_hero_path(@hero), method: :patch, id: "hero-form" do |f| %>

    <div class="hero-header-title">
      <h1><%= @hero.name %></h1>
      <div class="class-name">
        <%= I18n.t("hero.origin.#{@hero.origin}", default: @hero.origin.humanize) %> | <%= I18n.t("hero.klass.#{@hero.klass}", default: @hero.klass.humanize) %>
      </div>
    </div>

    <div class="grid-main">
      <!-- Left Column -->
      <div>
        <!-- Name & Origin -->
        <div class="card" style="display: flex; gap: 10px;">
          <%= f.text_field :name, value: @hero.name, placeholder: "Hero name", maxlength: 100, style: "flex: 2; padding: 8px; background: var(--input-bg); border: 1px solid var(--border-dark); color: var(--text-primary); font-size: 1rem;" %>
          <%= f.select :origin, Hero.origins.keys.map { |origin| [I18n.t("hero.origin.#{origin}", default: origin.humanize), origin] }, {}, style: "flex: 1; padding: 8px; background: var(--input-bg); border: 1px solid var(--border-dark); color: var(--text-primary); font-size: 1rem;" %>
        </div>

        <!-- Base Stats -->
        <div class="card">
          <table class="base-stats">
            <thead>
              <tr>
                <th>Уровень</th>
                <th>Опыт ✨</th>
                <th>Здоровье ❤️</th>
                <th>Броня 🛡️</th>
                <th>Урон ⚔️</th>
                <th>Монеты 🪙</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="no-padding">
                  <%= f.number_field :level, value: @hero.level, min: 1, max: 10, class: "param" %>
                </td>
                <td class="no-padding">
                  <%= f.number_field :xp, value: @hero.xp, min: 0, class: "param" %>
                </td>
                <td class="no-padding">
                  <%= f.number_field :hp_current, value: @hero.hp_current || 10, min: 0, class: "param" %>
                </td>
                <td class="no-padding">
                  <%= f.number_field :armor, value: @hero.armor || 0, min: -5, max: 10, class: "param" %>
                </td>
                <td class="no-padding">
                  <%= f.text_field :damage, value: @hero.damage || 'd6', class: "param" %>
                </td>
                <td class="no-padding">
                  <%= f.number_field :coins, value: @hero.coins || 0, min: 0, class: "param" %>
                </td>
              </tr>
              <tr>
                <td>-</td>
                <td>/<%= @hero.level + 7 %></td>
                <td>/<%= @hero.hp_max || 10 %></td>
                <td>-</td>
                <td>-</td>
                <td>-</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Stats -->
        <div class="card">
          <table class="stats">
            <thead>
              <tr>
                <th>СИЛ</th>
                <th>ЛОВ</th>
                <th>ТЕЛ</th>
                <th>ИНТ</th>
                <th>МДР</th>
                <th>ХАР</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <% %w[str dex con int wis cha].each do |stat| %>
                  <td class="no-padding">
                    <%= f.number_field "stat_#{stat}", value: @hero.send("stat_#{stat}") || 10, min: 1, max: 18, class: "param" %>
                  </td>
                <% end %>
              </tr>
              <tr>
                <% %w[str dex con int wis cha].each do |stat| %>
                  <% modifier = @hero.send("dice_mod_#{stat}") %>
                  <td class="text-center text-big">
                    <%= modifier.zero? ? '0' : (modifier.positive? ? "+#{modifier}" : modifier.to_s) %>
                  </td>
                <% end %>
              </tr>
              <tr>
                <% %w[str dex con int wis cha].each do |stat| %>
                  <td class="text-center">
                    <label class="checkbox-custom">
                      <%= f.check_box "deb_#{stat}", {}, true, false %>
                      <span class="checkbox-box"></span>
                      <span class="small">-1</span>
                    </label>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Tabs: Weapons, Equipment, Notes -->
        <div class="box">
          <div class="tabs">
            <button type="button" class="tab-button active" onclick="switchTab(event, 'tab-weapons')">Оружие</button>
            <button type="button" class="tab-button" onclick="switchTab(event, 'tab-equipment')">Снаряжение</button>
            <button type="button" class="tab-button" onclick="switchTab(event, 'tab-notes')">Заметки</button>
          </div>

          <div id="tab-weapons" class="tab-content active">
            <div class="form-group">
              <%= f.text_area :weapons, value: @hero.weapons, maxlength: 200, placeholder: "Меч, лук, кинжал...", class: "form-textarea", rows: 6, oninput: "updateCharCount('weapons', 200)" %>
              <div class="char-count"><span id="weaponsCount"><%= (@hero.weapons || '').length %></span>/200</div>
            </div>
          </div>

          <div id="tab-equipment" class="tab-content">
            <div class="form-group">
              <%= f.text_area :equipment, value: @hero.equipment, maxlength: 300, placeholder: "Броня, зелья, инструменты...", class: "form-textarea", rows: 6, oninput: "updateCharCount('equipment', 300)" %>
              <div class="char-count"><span id="equipmentCount"><%= (@hero.equipment || '').length %></span>/300</div>
            </div>
          </div>

          <div id="tab-notes" class="tab-content">
            <div class="form-group">
              <%= f.text_area :notes, value: @hero.notes, maxlength: 500, placeholder: "Цели, секреты, важное...", class: "form-textarea", rows: 6, oninput: "updateCharCount('notes', 500)" %>
              <div class="char-count"><span id="notesCount"><%= (@hero.notes || '').length %></span>/500</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div>
        <!-- Moves/Abilities -->
        <div class="box" style="min-height: 500px;">
          <h3 style="margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-dark);">Способности (<%= moves.length %>)</h3>
          <div id="abilitiesList">
            <% moves.each_with_index do |move, index| %>
              <div class="move-item" data-move-index="<%= index %>" draggable="true">
                <div class="move-item-header">
                  <span class="move-drag-handle">⋮⋮</span>
                  <%= text_field_tag "hero[moves][][name]", move['name'], placeholder: "Ability name", maxlength: 100 %>
                  <button type="button" class="move-remove-btn" onclick="removeMove(<%= index %>)">✕</button>
                </div>
                <%= text_area_tag "hero[moves][][desc]", move['desc'], placeholder: "Ability description...", maxlength: 500 %>
              </div>
            <% end %>
          </div>
          <button type="button" class="add-ability-btn" onclick="addMove()">+ Добавить способность</button>
        </div>
      </div>
    </div>

    <div style="text-align: right; font-size: 0.85rem; color: var(--text-secondary); margin-top: 20px;">
      Created: <%= @hero.created_at.strftime('%Y-%m-%d %H:%M') %>
    </div>
  <% end %>
</div>

<script>
  // Character counter
  function updateCharCount(fieldName, max) {
    const field = document.querySelector(`#hero_${fieldName}`);
    const counter = document.getElementById(`${fieldName}Count`);
    if (field && counter) {
      counter.textContent = field.value.length;
    }
  }

  // Tab switching (from ui.js pattern)
  function switchTab(event, tabId) {
    const button = event.target;
    const tabContainer = button.closest('.box');

    // Hide all tabs
    tabContainer.querySelectorAll('.tab-content').forEach(tab => {
      tab.classList.remove('active');
    });

    // Deactivate all buttons
    tabContainer.querySelectorAll('.tab-button').forEach(btn => {
      btn.classList.remove('active');
    });

    // Show selected tab
    document.getElementById(tabId).classList.add('active');
    button.classList.add('active');
  }

  // Abilities management
  let moveCounter = <%= moves.length %>;

  function addMove() {
    const list = document.getElementById('abilitiesList');
    const moveItem = document.createElement('div');
    moveItem.className = 'move-item';
    moveItem.dataset.moveIndex = moveCounter;
    moveItem.draggable = true;
    moveItem.innerHTML = `
      <div class="move-item-header">
        <span class="move-drag-handle">⋮⋮</span>
        <input type="text" name="hero[moves][][name]" placeholder="Ability name" maxlength="100">
        <button type="button" class="move-remove-btn" onclick="removeMove(${moveCounter})">✕</button>
      </div>
      <textarea name="hero[moves][][desc]" placeholder="Ability description..." maxlength="500"></textarea>
    `;
    list.appendChild(moveItem);
    setupDragAndDrop(moveItem);
    moveCounter++;
  }

  function removeMove(index) {
    const moveItem = document.querySelector(`[data-move-index="${index}"]`);
    if (moveItem) {
      moveItem.remove();
    }
  }

  function setupDragAndDrop(item) {
    item.addEventListener('dragstart', function(e) {
      this.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
    });

    item.addEventListener('dragend', function(e) {
      this.classList.remove('dragging');
      document.querySelectorAll('.move-item').forEach(el => {
        el.classList.remove('drag-over');
      });
    });

    item.addEventListener('dragover', function(e) {
      e.preventDefault();
      const dragging = document.querySelector('.dragging');
      if (dragging && dragging !== this) {
        this.classList.add('drag-over');
      }
    });

    item.addEventListener('dragleave', function(e) {
      this.classList.remove('drag-over');
    });

    item.addEventListener('drop', function(e) {
      e.preventDefault();
      this.classList.remove('drag-over');

      const dragging = document.querySelector('.dragging');
      if (dragging && dragging !== this) {
        const list = document.getElementById('abilitiesList');
        const allItems = [...list.querySelectorAll('.move-item')];
        const dragIndex = allItems.indexOf(dragging);
        const dropIndex = allItems.indexOf(this);

        if (dragIndex < dropIndex) {
          this.parentNode.insertBefore(dragging, this.nextSibling);
        } else {
          this.parentNode.insertBefore(dragging, this);
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.move-item').forEach(item => {
      setupDragAndDrop(item);
    });
  });
</script>
