<p class="roster-count">characters · <b><%= @characters.size %></b> of 10</p>

<div class="roster">
  <% @characters.each do |character| %>
    <%= link_to character_path(character), class: "char-card" do %>
      <span class="char-card__system"><%= character.system_name %></span>
      <span class="char-card__name"><%= character.name %></span>
      <span class="char-card__meta"><%= character.card_description %></span>
      <%# <span class="char-card__desc"><%= character.card_description </span> %>
    <% end %>
  <% end %>

  <% if @characters.size < 10 %>
    <%= link_to new_character_path, class: "char-create" do %>
      <span class="char-create__plus">+</span>
      <span class="char-create__label">create</span>
    <% end %>
  <% end %>
</div>