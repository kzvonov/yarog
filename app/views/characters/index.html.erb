<h3 class="capitalize">characters</h3>


<p><%= @characters.size %>/<%= Account::MAX_CHARACTERS %> characters</p>

<ul>
  <% @characters.each do |character| %>
    <li>
      <%= link_to character_path(character), class: "block-link" do %>
        <%= [character.name, character.type.demodulize, character.klass.titleize, character.origin.titleize].join(" · ") %>
      <% end %>
    </li>
  <% end %>
</ul>

<% if @characters.size < Account::MAX_CHARACTERS %>
  <div>
    <%= link_to new_character_path, class: "btn" do %>
      create
    <% end %>
  </div>
<% end %>
