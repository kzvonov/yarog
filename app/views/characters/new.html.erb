<%= form_with url: new_character_path, method: :get, data: { turbo_action: "replace" } do |f| %>
  <%= f.group(:system, "Pick a TTRPG") do %>
    <%= f.select :system,
        GameSystems::LIST,
        { selected: params[:system], include_blank: "..." },
        { onchange: "this.form.requestSubmit()" } %>
  <% end %>
<% end %>

<% if @character.type.present? && @character.class.enabled? %>
  <%= form_with model: @character.becomes(Character), url: characters_path, method: :post do |f| %>
    <%= f.hidden_field :type %>

    <%= f.group(:name) { f.text_field :name, autofocus: true } %>
    <%= f.group(:klass) { f.select :klass, @character.class.module_parent::Klass.for_select } %>
    <%= f.group(:origin) { f.select :origin, @character.class.module_parent::Origin.for_select } %>

    <%= f.group("") do %>
      <%= f.submit "create" %>
    <% end %>
    
  <% end %>
<% elsif @character.type.present? %>
  <p>not supported yet...</p>
<% end %>