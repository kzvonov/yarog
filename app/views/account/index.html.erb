<div class="grid-2">
  <div>
    <h3 class="capitalize mb-2">basics</h3>
    <%= form_with model: @account, url: account_path, method: :put do |f| %>

      <div class="form-group">
        <%= f.label "Handle (click to copy)", class: "form-label copy-handler", data: { "copy-value": @account.handle } %>
        <%= f.text_field :handle, value: @account.handle, class: "form-input", disabled: true %>
      </div>

      <%= f.group(:locale) { f.select :locale, [:en] } %>
      <%= f.group(:theme) { f.select :theme, [:auto, :day, :night] } %>
      
      <%= f.group("") do %>
        <%= f.submit "update" %>
      <% end %>
    <% end %>
  </div>

  <div>
    <h3 class="capitalize">identies</h3>
    <ul>
      <% @account.identities.each do |identity| %>
        <li><%= identity.provider %>: <%= identity.summary %> </li>
      <% end %>
    </ul>
  </div>
</div>