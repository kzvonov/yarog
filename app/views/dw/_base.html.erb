<%
  fields_configs = [
    { 
      field: :level,
      value: character.level,
      type: :number_field
    },
    {
      field: :xp,
      value: character.xp,
      type: :number_field,
      sub_value: "#{character.xp_to_next_level}"
    },
    {
      field: :coins,
      value: character.coins,
      type: :number_field
    },
    {
      field: :hp_current,
      value: character.hp_current,
      type: :number_field,
      sub_value: "#{character.hp_max}"
    },
    {
      field: :armor,
      value: character.armor,
      type: :number_field
    },
    {
      field: :damage,
      value: character.damage,
      type: :text_field
    }
  ]
%>

<%= form_with url: "", builder: ActionView::Helpers::FormBuilder, class: "dw-base-grid" do |f| %>
  <% fields_configs.each do |config| %>
    <div class="attr-cell"
         data-controller="field"
         data-action="click->field#focus">
      <div class="attr-lbl-container">
        <label class="attr-lbl" for="<%= config[:field] %>"><%= I18n.t("dungeon_world.text.base.#{config[:field]}") %></label>
        <% if config[:sub_value] %><span class="attr-sub">(<%= I18n.t("dungeon_world.text.of") %> <%= config[:sub_value] %>)</span><% end %>
      </div>
      <%= f.public_send(config[:type], config[:field], value: config[:value], data: { field_target: "input" }) %>
    </div>
  <% end %>
<% end %>