<!DOCTYPE html>
<html lang="ru">
  <head>
    <title>Yar'og</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%# It triggers a full realod instead of Turbo <meta name="turbo-visit-control" content="reload"> %>
    <meta name="turbo-refresh-method" content="morph">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# <%= stylesheet_link_tag "master", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tg", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
  </head>
  <body>
    <% if Current.session %>
      <header>
        <%= link_to "account", tg_account_path, class: "topbar-btn" %>
        <span><%= yield :character_name %></span>
        <a class="topbar-btn" href="#">Characters</a>
      </header>
    <% end%>

    <main>
      <%= yield %>
    </main>

    <%= yield :bottom_nav %>
  </body>
</html>
