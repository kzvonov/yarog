<!DOCTYPE html>
<html lang="ru" data-theme="<%= theme %>">
  <head>
    <title>Yar'og</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%# It triggers a full realod instead of Turbo <meta name="turbo-visit-control" content="reload"> %>
    <meta name="turbo-refresh-method" content="morph">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# <%= stylesheet_link_tag "master", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tg", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script>
      (function() {
        const savedTheme = '<%= theme %>';

        function applyAutoTheme() {
          if (savedTheme === 'auto') {
            const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', isDark ? 'night' : 'day');
          }
        }

        // Apply theme immediately
        applyAutoTheme();

        // Listen for system theme changes only when in auto mode
        if (savedTheme === 'auto') {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            document.documentElement.setAttribute('data-theme', e.matches ? 'night' : 'day');
          });
        }
      })();
    </script>
  </head>
  <body>
    <% if Current.session %>
      <header>
        <%= link_to "account", tg_account_path, class: "topbar-btn" %>
        <span><%= yield :character_name %></span>
        <a class="topbar-btn" href="#">Characters</a>
      </header>
    <% end%>

    <main>
      <%= yield %>
    </main>

    <%= yield :bottom_nav %>
  </body>
</html>
